# Deployment (SSH key) — example
# Copy to .env and fill values
#
# Auto deploy:
# - `npm run build` triggers `postbuild` -> `node scripts/deploy.js`
# - If required DEPLOY_* vars are missing, deploy is skipped (exit 0)

# SSH connection
DEPLOY_HOST=your.server.ip
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_SSH_KEY_PATH=C:/.ssh/id_rsa

# Remote web root
DEPLOY_REMOTE_PATH=/path/to/site/root

# Local build folder (CRA uses ./build)
DEPLOY_LOCAL_BUILD_PATH=./build

# Zip name
DEPLOY_ARCHIVE_NAME=deploy.zip
